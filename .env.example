# Analytics (optional). Copy to .env.local for local production builds, and
# set the same variables in your hosting provider's environment settings.
# Without NEXT_PUBLIC_UMAMI_WEBSITE_ID, no analytics script is loaded.
# Analytics never loads during `npm run dev`.

# From Umami Cloud: Settings > Websites > your site > Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: only count visits on these domains (comma-separated), so
# localhost and preview deploys stay out of your stats.
# NEXT_PUBLIC_UMAMI_DOMAINS=example.com,www.example.com

# Optional: only if you self-host Umami instead of using Umami Cloud.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
